# ==========================================
# FastAPI & Application Specific
# ==========================================
# Never commit credentials or local configuration files
.env
.env.*
!.env.example

# Local SQLite databases (frequently used in FastAPI development/testing)
*.db
*.sqlite
*.sqlite3

# Log files generated by Uvicorn, Gunicorn, or loguru
*.log
logs/

# ==========================================
# Python Virtual Environments
# ==========================================
.venv/
venv/
ENV/
env/

# ==========================================
# Byte-compiled / Optimized / DLL files
# ==========================================
__pycache__/
*.py[cod]
*$py.class
*.so

# ==========================================
# Testing & Code Quality
# ==========================================
# Pytest and coverage artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml

# Linters and type checkers
.mypy_cache/
.ruff_cache/
.black
.pyre/
.pytype/

# ==========================================
# IDEs and Editors
# ==========================================
# VS Code
.vscode/
!.vscode/extensions.json
!.vscode/launch.json

# PyCharm / JetBrains
.idea/

# Editor temporary files
*.swp
*~

# ==========================================
# OS Generated Files
# ==========================================
.DS_Store
Thumbs.db

# ==========================================
# Packaging & Distribution (If building a package)
# ==========================================
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
